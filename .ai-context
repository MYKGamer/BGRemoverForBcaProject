│   └── page.tsx                      # Product Landing page
├── components/
│   ├── ui/                           # Shadcn primitive elements (button, card, sheet, etc.)
│   └── before-after-slider.tsx       # Interactive UI slider comparing original vs result
├── lib/
│   └── supabase/client.ts            # Client-side Supabase connection client
└── utils/
    └── supabase/
        ├── admin.ts                  # Service role client bypassing RLS for credits deduction
