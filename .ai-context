│   │   │   └── pricing-view.tsx      # Credit packages display
│   │   ├── dashboard-shell.tsx       # Desktop sidebar & mobile hamburger drawers (SPA views)
│   │   ├── history-grid.tsx          # Creations grid with rename, download, and delete
│   │   ├── upload-zone.tsx           # Drag & Drop dropzone + passcode verification
│   │   └── page.tsx                  # Main server dashboard entry page
